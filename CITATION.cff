    given-names: "Cole"
version: 2.3.0
date-released: "2026-07-11"
url: "https://github.com/munzzyy/liftmath"
repository-code: "https://github.com/munzzyy/liftmath"
license-url: "https://github.com/munzzyy/liftmath/blob/main/LICENSE"
keywords:
