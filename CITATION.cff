    given-names: "Cole"
version: 0.1.0
date-released: "2026-07-05"
url: "https://github.com/munzzyy/liftmath"
repository-code: "https://github.com/munzzyy/liftmath"
license: MIT
keywords:
  - strength-training
  - one-rep-max
  - powerlifting
  - hypertrophy
  - fitness
